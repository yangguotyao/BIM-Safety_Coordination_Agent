# 外层 D:/BIM-Safety_Coordination_Agent/.env 存在时优先读取；否则读取 backend/.env。
# 默认演示模式不调用收费 API，复制本文件时不要覆盖已有密钥。
DEMO_MODE=true

# 真实模型模式（可选）。DEMO_MODE=false 时必须三项齐全，否则 /api/health 显示 live_incomplete，
# 分析接口返回可操作错误，不会静默降级。
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_NAME=deepseek-v4-flash
MODEL_TIMEOUT_SECONDS=180
MODEL_ENABLE_THINKING=false

# Qwen：上传 PNG/JPG 的观察候选，须人工核对；不从图像推断米制高度。
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen3.7-plus
VISION_TIMEOUT_SECONDS=180
VISION_ENABLE_THINKING=false

# 运行
HOST=127.0.0.1
PORT=8001

# 演示固定时钟
DEMO_CLOCK=2026-10-16T09:00:00+08:00

# 可选：覆盖资料根目录与运行目录
# DATA_ROOT=../01_资料与依据
# RUNTIME_DIR=./runtime
